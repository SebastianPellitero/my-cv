# Upstash Redis, added automatically by the Vercel Marketplace integration.
# Locally: vercel env pull .env.local
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Long random value for the admin login, e.g. from: openssl rand -base64 32
ADMIN_SECRET=

# Address that receives slot picks, also shown on the expired-link page
CONTACT_EMAIL=

# Sends the slot-pick email. Create one at resend.com, with "Sending access"
RESEND_API_KEY=

# Optional sender, for a domain verified in Resend. Defaults to Resend's onboarding address
# RESEND_FROM=Availability <availability@sebastianpellitero.dev>
